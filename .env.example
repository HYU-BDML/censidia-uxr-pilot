# Copy to .env.local and fill in. Never commit .env.local.
# AI 인터뷰 질문 생성 — Kimi(Moonshot 국제판, OpenAI 호환 API)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_INTERVIEW_MODEL=kimi-k3
KIMI_THINKING=disabled
# 음성 전사 — OpenAI Whisper (Kimi 는 음성 전사 API 가 없다)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# 별도 전사 서버(선택, 설정되면 OpenAI 보다 우선)
MINDLENS_SPEECH_API_URL=
MINDLENS_SPEECH_API_TOKEN=
